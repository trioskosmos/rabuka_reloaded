# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Source code and configuration files
*.rs text eol=lf
*.py text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.js text eol=lf
*.css text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf

# Binary files
*.bin binary
*.bin.z binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.wasm binary
*.db binary
