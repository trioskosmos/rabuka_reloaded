+/// One-shot flags set by `finalize_card_movement` / `execute_energy_placement`
+/// that watcher auto-abilities (e.g. Sumire's "moves" condition) read during
+/// the post-completion scan.  The caller snapshots these before `clear_effect_tracking`,
+/// restores them for the scan, then clears them to prevent re-fire loops.
+#[derive(Debug, Clone)]
+pub struct MoveTriggerFlags {
+    pub last_area_move_card_id: Option<i16>,
+    pub last_area_move_by_player: Option<String>,
+    pub last_energy_placed_by_effect: bool,
+    pub last_energy_placed_by_player: Option<String>,
+}
