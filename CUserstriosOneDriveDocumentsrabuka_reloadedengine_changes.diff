+    /// Snapshot the one-shot move/energy trigger flags. These must survive
+    /// `clear_effect_tracking()` so watcher abilities (e.g. Sumire's
+    /// "moves (area_move/energy_placed)") can still evaluate their conditions
+    /// during the post-completion `process_pending_auto_abilities` scan. The
+    /// caller must pass the snapshot to [`restore_move_trigger_flags`] before
+    /// the scan and call [`clear_move_trigger_flags`] afterwards — otherwise
+    /// the same ability re-fires every loop iteration and overflows the stack.
+    pub fn snapshot_move_trigger_flags(&self) -> MoveTriggerFlags {
+        MoveTriggerFlags {
+            last_area_move_card_id: self.last_area_move_card_id,
+            last_area_move_by_player: self.last_area_move_by_player.clone(),
+            last_energy_placed_by_effect: self.last_energy_placed_by_effect,
+            last_energy_placed_by_player: self.last_energy_placed_by_player.clone(),
+        }
+    }
+
+    pub fn restore_move_trigger_flags(&mut self, flags: MoveTriggerFlags) {
+        self.last_area_move_card_id = flags.last_area_move_card_id;
+        self.last_area_move_by_player = flags.last_area_move_by_player;
+        self.last_energy_placed_by_effect = flags.last_energy_placed_by_effect;
+        self.last_energy_placed_by_player = flags.last_energy_placed_by_player;
+    }
+
+    pub fn clear_move_trigger_flags(&mut self) {
+        self.last_area_move_card_id = None;
+        self.last_area_move_by_player = None;
+        self.last_energy_placed_by_effect = false;
+        self.last_energy_placed_by_player = None;
+    }
