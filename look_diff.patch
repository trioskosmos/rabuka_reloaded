+    // Q85: Handle look-at-N when deck has < N cards.
+    //
+    // Multi-step procedure:
+    //   ① Take all available cards from deck
+    //   ② If deck is now 0 and waitroom has cards → refresh (Rule 10.2.2.1)
+    //   ③ If we still need more, draw remaining from refreshed deck
+    //   ④ Assign combined cards to looked_at_cards
+    //
+    // This is the Q85 procedure: "look at 5, deck has 4"
+    //   → look 4 from deck
+    //   → need 1 more → refresh (shuffle waitroom UNDER the 4)
+    //   → look 1 more from refreshed deck
+    //   → total 5 in looked_at_cards → resolve selection
+    //
+    // Q101: If BOTH deck and waitroom are empty, we stop with whatever we have.
+    //   The effect does as much as possible per Rule 1.3.2.
+    //
+    // Q104: Mill effects — the just-milled cards reach the waitroom before
+    //   refresh is checked, so they ARE included in the refresh.
+    fn execute_look_at_insufficient_deck(
+        &mut self,
+        gs: &mut GameState,
+        _effect: &AbilityEffect,
+        count: u32,
+        target: &str,
+        _source: &str,
+    ) -> Result<(), String> {
+        let count = count as usize;
+
+        // Q85 step ①: Draw all available cards from deck (at most count)
+        let first_batch = {
+            let player = gs.resolve_target_player_mut(target);
+            let to_take = std::cmp::min(player.main_deck.cards.len(), count);
+            if to_take == 0 {
+                Vec::new()
+            } else {
+                player.main_deck.draw_multiple(to_take)
+            }
+        };
+
+        // Q85 step ②: If we still need more and deck is now empty, refresh
+        let mut looked = first_batch;
+        if looked.len() < count {
+            let remaining = count - looked.len();
+            {
+                let player = gs.resolve_target_player_mut(target);
+                if player.main_deck.cards.is_empty() && !player.waitroom.cards.is_empty() {
+                    // Rule 10.2.3: Shuffle waitroom → new deck
+                    // (deck is empty, so all waitroom cards become the deck)
+                    player.refresh();
+                }
+            }
+
+            // Q85 step ③: Draw remaining from refreshed deck
+            let player = gs.resolve_target_player_mut(target);
+            if !player.main_deck.cards.is_empty() {
+                let more = std::cmp::min(remaining, player.main_deck.cards.len());
+                let extra = player.main_deck.draw_multiple(more);
+                looked.extend(extra);
+            }
+        }
+
+        gs.looked_at_cards = looked;
+        Ok(())
+    }
