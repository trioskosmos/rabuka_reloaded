/* ── Ported from engine/src/core/types.rs::EffectData ───────────────────
     The Rust EffectData enum carries per-effect payloads for HeartOverride,
     SingleCard, MultiCard, SetBladeCount, SurplusHeart, and GainAbility.
     The C port models the single-card variant as RbEffectDataSingleCard and
     exposes accessors mirroring the Rust enum methods. The previous port
     simplified count()/items()/amount() incorrectly — these now mirror Rust
     exactly (count is HeartOverride-only, amount is SingleCard|AllCards,
     old_value is SurplusHeart-only). ── */

#include "rabuka.h"
#include <string.h>

/* Mirror EffectData::items — fill out_items[i]/{card_id,amount,color} for
   SingleCard (1 item) or MultiCard (N items). Returns the number of items
   written (0 for variants that yield no items: HeartOverride / SetBladeCount
   / SurplusHeart / GainAbility). Mirrors Rust EffectData::items. */
int rb_effect_data_items(const RbEffectDataSingleCard *d, int card_id,
                         int *out_amount, char *out_color, size_t color_sz)
{
    if (!d || d->card_id != card_id) return 0;
    if (out_amount) *out_amount = d->amount;
    if (out_color && color_sz > 0) {
        if (d->color[0]) {
            strncpy(out_color, d->color, color_sz - 1);
            out_color[color_sz - 1] = '\0';
        } else {
            out_color[0] = '\0';
        }
    }
    return 1;
}

/* Mirror EffectData::is_p1 — SurplusHeart variant only. The C flat model has
   no SurplusHeart variant, so this always returns 0 (mirrors the Rust
   Option::None branch). */
int rb_effect_data_is_p1(const RbEffectDataSingleCard *d)
{
    (void)d;
    return 0;
}

/* Mirror EffectData::old_value — SurplusHeart variant only. The C flat model
   has no SurplusHeart variant, so this always returns 0 via the out param
   and reports failure (mirrors Rust Option::None). */
int rb_effect_data_old_value(const RbEffectDataSingleCard *d, int *out)
{
    (void)d;
    if (out) *out = 0;
    return 0;
}

/* Mirror EffectData::count — HeartOverride variant only. The C flat model
   stores amount; there is no separate count field, so this reports 0/not
   found for the SingleCard variant (mirrors Rust: SingleCard → None). */
int rb_effect_data_count(const RbEffectDataSingleCard *d, int *out)
{
    if (!d || !out) return 0;
    *out = 0;
    return 0;
}

/* Mirror EffectData::color — returns the color string for HeartOverride and
   SingleCard variants, NULL otherwise. The C flat model is SingleCard, so
   this returns d->color when non-empty (mirrors Rust
   EffectData::SingleCard { color, .. } => color.as_deref()). */
const char *rb_effect_data_color(const RbEffectDataSingleCard *d)
{
    if (!d || !d->color[0]) return NULL;
    return d->color;
}

/* Mirror EffectData::amount — SingleCard and AllCards variants. The C flat
   model is SingleCard, so this returns d->amount (mirrors Rust
   EffectData::SingleCard { amount, .. } => Some(*amount)). */
int rb_effect_data_amount(const RbEffectDataSingleCard *d)
{
    if (!d) return 0;
    return d->amount;
}
